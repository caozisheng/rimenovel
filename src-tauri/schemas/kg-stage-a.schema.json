{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kg_stage_a",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","chapter_idx","summary","open_threads","mentions","events"],
  "properties": {
    "schema_version":{"const":"kg-stage-a/v1"}, "chapter_idx":{"type":"integer","minimum":1}, "summary":{"type":"string"},
    "open_threads":{"type":"array","items":{"type":"string"}},
    "mentions":{"type":"array","items":{"$ref":"#/$defs/mention"}},
    "events":{"type":"array","items":{"$ref":"#/$defs/event"}}
  },
  "$defs": {
    "refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "mention":{"type":"object","additionalProperties":false,"required":["mention_id","name","entity_type","candidate_keys","evidence_refs"],"properties":{"mention_id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"entity_type":{"enum":["character","location","item","faction","concept"]},"candidate_keys":{"type":"array","items":{"type":"string"}},"evidence_refs":{"$ref":"#/$defs/refs"}}},
    "event":{"type":"object","additionalProperties":false,"required":["key","title","category","chapter_idx","observed_chapter","observed_order","temporal_scope","assertion_kind","participants","location","summary","outcome","cause_keys","evidence_refs"],"properties":{"key":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"category":{"enum":["conflict","battle","meeting","parting","journey","discovery","betrayal","deal","loss","death","romance","mystery","other"]},"chapter_idx":{"type":"integer","minimum":1},"observed_chapter":{"type":"integer","minimum":1},"observed_order":{"type":"integer","minimum":0},"temporal_scope":{"enum":["current","historical","unspecified"]},"assertion_kind":{"enum":["confirmed","reported","inferred"]},"participants":{"type":"array","items":{"type":"string","minLength":1}},"location":{"type":["string","null"]},"summary":{"type":"string"},"outcome":{"type":"string"},"cause_keys":{"type":"array","items":{"type":"string","minLength":1}},"evidence_refs":{"$ref":"#/$defs/refs"}}}
  }
}
