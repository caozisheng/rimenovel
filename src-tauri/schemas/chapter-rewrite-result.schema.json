{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"chapter_rewrite_result",
  "type":"object",
  "additionalProperties":false,
  "required":["prose","actual_chapter_wiki"],
  "properties":{
    "prose":{"type":"string","pattern":".*\\S.*"},
    "actual_chapter_wiki":{
      "type":"object","additionalProperties":false,
      "required":["chapter_idx","chapter","entries"],
      "properties":{
        "chapter_idx":{"type":"integer","minimum":1},
        "chapter":{
          "type":"object","additionalProperties":false,
          "required":["headline","narrative","ending"],
          "properties":{
            "headline":{"type":"string","minLength":1},
            "narrative":{"type":"string","minLength":1},
            "ending":{"type":"object","additionalProperties":false,"required":["open_threads"],"properties":{"open_threads":{"type":"array","items":{"type":"string"}}}}
          }
        },
        "entries":{"type":"array","items":{"$ref":"#/$defs/entry"}}
      }
    }
  },
  "$defs":{
    "entry":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","name","aliases","summary","state_items","related_entries","open_threads","source_chapters"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "kind":{"type":"string","enum":["character","faction","location","item","setting"]},
        "name":{"type":"string","minLength":1},
        "aliases":{"type":"array","items":{"type":"string"}},
        "summary":{"type":"string"},
        "state_items":{"type":"array","items":{"type":"string"}},
        "related_entries":{"type":"array","items":{"type":"string"}},
        "open_threads":{"type":"array","items":{"type":"string"}},
        "source_chapters":{"type":"array","items":{"type":"integer"}}
      }
    }
  }
}
